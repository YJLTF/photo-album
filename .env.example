# ===== Local development =====
# Frontend → backend address. Leave empty in Docker (uses /api relative).
VITE_API_URL=http://localhost:80/api

# ===== Docker / production =====
# Port the backend listens on (and that the host maps to).
PORT=80

# REQUIRED in production. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
