# ============================================================
# 根目录 .env —— 供 docker-compose 使用（本地开发见文末说明）
# ============================================================

# 宿主机映射端口（容器内后端同端口）。默认 80，浏览器访问 http://localhost:PORT
PORT=80

# 必填。用 `openssl rand -hex 32` 生成一个强随机值；未设置时 compose 不会启动
JWT_SECRET=change-me-to-a-long-random-string

# 可选。前端构建时使用的 API 地址：
# - 留空 / 不设置：同源部署，前端用相对路径 /api（推荐）
# - 跨域部署（前端与后端不同源）时填后端完整地址，如 https://api.example.com/api
# 注意：修改后需要 `docker-compose up -d --build` 重新构建才生效
#VITE_API_URL=

# ============================================================
# 可选的存储路径（一般无需修改，Docker 内已由 compose 指定）
# ============================================================
#DATABASE_PATH=./data/photo-album.sqlite
#UPLOAD_DIR=./uploads

# ============================================================
# 本地开发（不走 Docker）说明：
#   1. 后端配置在 backend/.env（PORT / JWT_SECRET），默认端口 3001
#   2. 前端通过根目录 .env 的 VITE_API_URL 指向后端，例如：
#      VITE_API_URL=http://localhost:3001/api
# ============================================================

# ============================================================
# 以下变量由后端在容器启动时读取（也可只配在 backend/.env）
# ============================================================

# 可选。访问密钥加密存储的派生密钥；不设置则复用 JWT_SECRET。
# 注意：更换 JWT_SECRET / KEY_SECRET 会使已存储的访问密钥无法解密，相当于重置全部密钥
#KEY_SECRET=

# 可选。回收站保留天数，超期自动彻底删除；设为 0 或负数关闭自动清理
#RECYCLE_RETENTION_DAYS=30

# 可选。部署在 nginx 等反向代理之后时设为 1，登录限流按真实客户端 IP 计数；
# 直连部署保持关闭，避免 X-Forwarded-For 伪造绕过限流
#TRUST_PROXY=
