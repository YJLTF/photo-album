# 后端环境变量模板：复制为 backend/.env 并按需修改

# 必填。JWT 签名密钥，用 `openssl rand -hex 32` 生成；未设置时后端启动直接失败
JWT_SECRET=

# 可选。访问密钥加密存储的派生密钥；不设置则复用 JWT_SECRET
#KEY_SECRET=

# 可选。服务监听端口，默认 3001
#PORT=3001

# 可选。SQLite 数据库文件路径，默认 ./data/photo-album.sqlite
#DATABASE_PATH=./data/photo-album.sqlite

# 可选。上传文件存储目录，默认 ./uploads
#UPLOAD_DIR=./uploads

# 可选。回收站保留天数，超期自动彻底删除；设为 0 或负数关闭自动清理，默认 30
#RECYCLE_RETENTION_DAYS=30

# 可选。部署在 nginx 等反向代理之后时设为 1（登录限流按真实客户端 IP 计数）
#TRUST_PROXY=
